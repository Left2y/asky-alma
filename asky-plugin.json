      "effect": "read",
      "confirmation": "never",
      "timeoutSeconds": 20,
      "inputSchema": {
        "type": "object",
        "properties": {"what": {"type": "string", "enum": ["status", "reply", "history", "threads", "help"]}},
        "additionalProperties": false
      }
    }
  ],
  "commands": [
    {"name": "alma", "title": "Alma · 持久会话", "subtitle": "输入问题续聊；/help 查看命令；回车执行", "keyword": "alma", "tool": "chat", "mode": "action", "queryArgument": "input"}
  ]
}
